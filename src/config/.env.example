# ============================================================
# Ultimate Instagram AI Automation — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp src/config/.env.example .env

# ========== GEMINI AI (Required) ==========
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Model selection (defaults shown — free tier models)
# GEMINI_REASONING_MODEL=gemini-2.5-flash
# GEMINI_LITE_MODEL=gemini-2.5-flash-lite
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Temperature settings
# GEMINI_CREATIVE_TEMPERATURE=0.9
# GEMINI_ANALYSIS_TEMPERATURE=0.3
# GEMINI_DEFAULT_TEMPERATURE=0.7
# GEMINI_MAX_TOKENS=8192

# ========== META / INSTAGRAM GRAPH API ==========
# Create a Meta App at: https://developers.facebook.com/apps/
# Required permissions: instagram_business_basic, instagram_business_content_publish
META_APP_ID=your-meta-app-id-here
META_APP_SECRET=your-meta-app-secret-here

# Graph API version (update as needed)
# INSTAGRAM_GRAPH_API_VERSION=v25.0

# Max posts per day per account (official limit is 100, we default to 3)
# INSTAGRAM_MAX_POSTS_PER_DAY=3

# Public URL where generated images are served for Instagram to fetch
# Instagram cURLs this URL, so it MUST be publicly accessible
# For local dev, use a tunneling service like ngrok
MEDIA_UPLOAD_BASE_URL=http://localhost:8000/media

# ========== DATABASE ==========
# SQLite (development):
DATABASE_URL=sqlite+aiosqlite:///./data/automation.db

# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/instagram_automation

# Set to true for SQL query logging
# DATABASE_ECHO=false

# ========== AUTHENTICATION ==========
# JWT secret — CHANGE THIS IN PRODUCTION!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-random-secret-in-production

# JWT token expiry in hours
# JWT_EXPIRY_HOURS=24

# Fernet key for encrypting stored Instagram access tokens
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate-a-fernet-key-here

# ========== STORAGE ==========
# CHROMA_PERSIST_DIRECTORY=./data/chroma_db
# CONTENT_STORAGE_PATH=./data/content
# IMAGES_STORAGE_PATH=./data/images

# ========== APPLICATION ==========
# APP_HOST=0.0.0.0
# APP_PORT=8000
# DEBUG=false
# LOG_LEVEL=INFO
