# ========== LOCAL AI MODELS ==========
# Ollama configuration (no API key needed - runs locally)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ========== AI MODEL SETTINGS ==========
# Gemini configuration (Upgraded to 2.0 Flash)
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=4096
GEMINI_CREATIVE_TEMPERATURE=0.9
GEMINI_ANALYSIS_TEMPERATURE=0.3

# Perplexity configuration (premium model for your subscription)
PERPLEXITY_MODEL=llama-3.1-sonar-huge-128k-online
PERPLEXITY_TEMPERATURE=0.3
PERPLEXITY_MAX_TOKENS=1024

# ========== STORAGE PATHS ==========
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CONTENT_STORAGE_PATH=./data/content
IMAGES_STORAGE_PATH=./data/images
CAMPAIGN_STORAGE_PATH=./data/campaigns

# ========== CONTENT SETTINGS ==========
MIN_ENGAGEMENT_SCORE=0.7
MAX_CONTENT_AGE_DAYS=7
MAX_POSTS_PER_DAY=3
MIN_TIME_BETWEEN_POSTS=4

# ========== CAMPAIGN & TESTING ==========
AB_TEST_ENABLED=true
AB_TEST_MIN_SAMPLE_SIZE=100
AB_TEST_CONFIDENCE_LEVEL=0.95
MAX_ACTIVE_CAMPAIGNS=3
DEFAULT_CAMPAIGN_DURATION=7

# ========== RATE LIMITING ==========
MAX_ACTIONS_PER_HOUR=10
DELAY_BETWEEN_ACTIONS=30
GEMINI_REQUESTS_PER_MINUTE=15
PERPLEXITY_REQUESTS_PER_MINUTE=20

# ========== POSTING SCHEDULE ==========
POSTING_TIMES=09:00,14:00,18:00

# ========== SETUP INSTRUCTIONS ==========
# 1. Get your Gemini API key from: https://aistudio.google.com/app/apikey
# 2. Get your Perplexity API key from: https://www.perplexity.ai/settings/api
# 3. Install Ollama from: https://ollama.com/download
# 4. Run: ollama pull nomic-embed-text
# 5. Start Ollama: ollama serve
# 6. Run the system: python run_ultimate_automation.py
